okeWidth=2;" vertex="1" parent="1"><mxGeometry x="1400" y="150" width="560" height="340" as="geometry"/></mxCell><mxCell id="c92" value="&lt;b&gt;Mejora posible (no implementada)&lt;/b&gt;&lt;br&gt;Filtro RC en cada entrada ADC (×5)" style="text;html=1;whiteSpace=wrap;fontSize=14;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1416" y="158" width="530" height="50" as="geometry"/></mxCell><mxCell id="c93" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1420" y="250" width="100" height="60" as="geometry"/></mxCell><mxCell id="c94" value="W" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;rounded=0;fontSize=14;fontStyle=1;fillColor=#C8E6C9;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1520" y="268" width="36" height="24" as="geometry"/></mxCell><mxCell id="c95" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;strokeColor=#2E7D32;fontSize=14;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1556" y="280" as="sourcePoint"/><mxPoint x="1590" y="280" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c96" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1590" y="268" width="80" height="24" as="geometry"/></mxCell><mxCell id="c97" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;strokeColor=#2E7D32;fontSize=14;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1670" y="280" as="sourcePoint"/><mxPoint x="1820" y="280" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c98" value="" style="ellipse;fillColor=#2E7D32;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="1735" y="275" width="10" height="10" as="geometry"/></mxCell><mxCell id="c99" value="GPIO (ADC1)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;rounded=0;fontSize=14;fontStyle=1;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1820" y="268" width="110" height="24" as="geometry"/></mxCell><mxCell id="c100" value="&lt;b&gt;R&lt;/b&gt; 1 kΩ" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1580" y="232" width="110" height="30" as="geometry"/></mxCell><mxCell id="c101" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1725" y="310" width="30" height="60" as="geometry"/></mxCell><mxCell id="c102" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;strokeColor=#2E7D32;fontSize=14;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1740" y="280" as="sourcePoint"/><mxPoint x="1740" y="310" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c103" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;strokeColor=#212121;fontSize=14;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1740" y="370" as="sourcePoint"/><mxPoint x="1740" y="396" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c104" value="GND" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;rounded=0;fontSize=14;fontStyle=1;fillColor=#E0E0E0;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1705" y="396" width="70" height="24" as="geometry"/></mxCell><mxCell id="c105" value="&lt;b&gt;C&lt;/b&gt; 100 nF&lt;br&gt;cerámico" style="text;html=1;whiteSpace=wrap;fontSize=14;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1762" y="322" width="120" height="40" as="geometry"/></mxCell><mxCell id="c106" value="f&lt;sub&gt;c&lt;/sub&gt; = 1 / (2π·R·C) ≈ 1,6 kHz · R y C lo más cerca posible del pin del ESP32" style="text;html=1;whiteSpace=wrap;fontSize=14;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1416" y="432" width="530" height="50" as="geometry"/></mxCell><mxCell id="c107" value="&lt;b style='font-size:26px'&gt;Diagrama de conexionado — Transmisor (guante)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="4" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c108" value="Fuente: Transmisor.ino (pines) · Ilustraciones representativas · Notas y BOM en hoja 2" style="text;html=1;whiteSpace=wrap;fontSize=14;align=right;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1240" y="10" width="720" height="30" as="geometry"/></mxCell><mxCell id="c109" value="&lt;b&gt;Referencias&lt;/b&gt;&lt;br&gt;&lt;span style='color:#D32F2F;font-weight:bold'&gt;━━━&lt;/span&gt; +5 V (USB)&lt;br&gt;&lt;span style='color:#C2185B;font-weight:bold'&gt;━━━&lt;/span&gt; +3,3 V&lt;br&gt;&lt;span style='color:#212121;font-weight:bold'&gt;━━━&lt;/span&gt; GND&lt;br&gt;&lt;span style='color:#2E7D32;font-weight:bold'&gt;━━━&lt;/span&gt; Cursor analógico (0–3,3 V)&lt;br&gt;&lt;span style='color:#00838F;font-weight:bold'&gt;━━━&lt;/span&gt; I2C SCL&lt;br&gt;&lt;span style='color:#1565C0;font-weight:bold'&gt;━━━&lt;/span&gt; I2C SDA&lt;br&gt;&lt;span style='color:#9E9E9E;font-weight:bold'&gt;┅┅┅&lt;/span&gt; Mejora posible&lt;br&gt;● Unión soldada · ⌒ Cruce sin conexión" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#FAFAFA;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="1400" y="640" width="300" height="215" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="notas" name="Notas y materiales"><mxGraphModel dx="1380" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c110" value="&lt;b style='font-size:26px'&gt;Transmisor — Notas de montaje y lista de materiales&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="44" as="geometry"/></mxCell><mxCell id="c111" value="&lt;b style='font-size:20px'&gt;Notas de montaje&lt;/b&gt;&lt;ol style='margin:8px 0 0 0;padding-left:24px;line-height:1.5'&gt;&lt;li&gt;Alimentación: powerbank USB 5 V al conector USB del ESP32; el regulador de la placa genera los 3,3 V. Algunos powerbanks se apagan solos con consumos bajos: verificar que el elegido mantenga la salida con el guante funcionando.&lt;/li&gt;&lt;li&gt;Los potenciómetros se alimentan desde &lt;b&gt;3V3, nunca desde 5 V&lt;/b&gt;: la entrada del ADC no debe superar 3,3 V.&lt;/li&gt;&lt;li&gt;Los cursores van a pines del &lt;b&gt;ADC1&lt;/b&gt; (GPIO32–39) porque el ADC2 no puede usarse con Wi-Fi/ESP-NOW activo. GPIO34–39 son solo entrada y sin pull-up interno, lo cual es correcto para esta aplicación.&lt;/li&gt;&lt;li&gt;Si un dedo lee al revés, el firmware lo admite (calibración invertida); también se pueden intercambiar los extremos 3V3/GND de ese potenciómetro.&lt;/li&gt;&lt;li&gt;MPU6050 (GY-521) con VCC a 5 V: el módulo típico tiene regulador a 3,3 V y pull-ups de SDA/SCL a 3,3 V, así el bus I2C queda a 3,3 V. &lt;b&gt;Verificar en el módulo usado.&lt;/b&gt; AD0 sin conectar (dirección 0x68, la que usa el firmware); INT no se usa.&lt;/li&gt;&lt;li&gt;Calibración: con el guante puesto, enviar &lt;code&gt;c&lt;/code&gt; por el monitor serie (115200 baudios) y seguir los pasos.&lt;/li&gt;&lt;/ol&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=12;fontSize=16;fillColor=#FFFDE7;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1300" height="320" as="geometry"/></mxCell><mxCell id="c112" value="&lt;b style='font-size:20px'&gt;Lista de materiales&lt;/b&gt;&lt;table style='font-size:16px;margin-top:8px' cellpadding='5'&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;U1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;ESP32 DevKit&lt;/td&gt;&lt;td width='40'&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;PB1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Powerbank USB 5 V&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;U2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Módulo MPU6050 (GY-521)&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;—&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Cable USB al conector del DevKit&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;P1…P5&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Potenciómetro rotativo 10 kΩ lineal (B)&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan='5'&gt;&lt;br&gt;&lt;b&gt;Mejoras posibles (no implementadas)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;R1…R5&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Resistencia 1 kΩ (filtro RC)&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;C1…C5&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Capacitor cerámico 100 nF (filtro RC)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;S1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Interruptor de encendido&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=12;fontSize=16;fillColor=#FAFAFA;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1300" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>