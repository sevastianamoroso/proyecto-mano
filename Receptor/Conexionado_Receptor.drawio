epresentativas · Notas y materiales en hoja 2" style="text;html=1;whiteSpace=wrap;fontSize=14;align=right;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1240" y="10" width="800" height="30" as="geometry" /></mxCell><mxCell id="c132" value="&lt;b&gt;Referencias&lt;/b&gt;&lt;br&gt;&lt;span style='color:#F57C00;font-weight:bold'&gt;━━━&lt;/span&gt; Señal PWM 3,3 V&lt;br&gt;&lt;span style='color:#D32F2F;font-weight:bold'&gt;━━━&lt;/span&gt; +5 V servos&lt;br&gt;&lt;span style='color:#1565C0;font-weight:bold'&gt;━━━&lt;/span&gt; +5 V USB (sólo ESP32)&lt;br&gt;&lt;span style='color:#212121;font-weight:bold'&gt;━━━&lt;/span&gt; GND&lt;br&gt;&lt;span style='color:#7B1FA2;font-weight:bold'&gt;━━━&lt;/span&gt; +12 V (entrada)&lt;br&gt;● Unión soldada / bornera&lt;br&gt;⌒ Cruce sin conexión&lt;br&gt;Servo: S naranja · + rojo · − marrón" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#FAFAFA;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="2100" y="690" width="260" height="205" as="geometry" /></mxCell><mxCell id="c140" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=3;strokeColor=#7B1FA2;fontSize=14;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1800" y="472" as="sourcePoint" /><mxPoint x="1800" y="482" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c141" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1780" y="482" width="40" height="80" as="geometry" /></mxCell><mxCell id="c142" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=3;strokeColor=#212121;fontSize=14;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1800" y="562" as="sourcePoint" /><mxPoint x="1800" y="572" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c143" value="" style="ellipse;fillColor=#7B1FA2;strokeColor=#7B1FA2;" vertex="1" parent="1"><mxGeometry x="1795" y="467" width="10" height="10" as="geometry" /></mxCell><mxCell id="c144" value="" style="ellipse;fillColor=#212121;strokeColor=#212121;" vertex="1" parent="1"><mxGeometry x="1795" y="567" width="10" height="10" as="geometry" /></mxCell><mxCell id="c145" value="&lt;b&gt;C3&lt;/b&gt;&lt;br&gt;470 µF&lt;br&gt;35 V&lt;br&gt;electrolítico" style="text;html=1;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1826" y="480" width="110" height="84" as="geometry" /></mxCell><mxCell id="c146" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=3;strokeColor=#7B1FA2;fontSize=14;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1960" y="472" as="sourcePoint" /><mxPoint x="1960" y="502" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c147" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1944" y="502" width="32" height="40" as="geometry" /></mxCell><mxCell id="c148" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=3;strokeColor=#212121;fontSize=14;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1960" y="542" as="sourcePoint" /><mxPoint x="1960" y="572" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c149" value="" style="ellipse;fillColor=#7B1FA2;strokeColor=#7B1FA2;" vertex="1" parent="1"><mxGeometry x="1955" y="467" width="10" height="10" as="geometry" /></mxCell><mxCell id="c150" value="" style="ellipse;fillColor=#212121;strokeColor=#212121;" vertex="1" parent="1"><mxGeometry x="1955" y="567" width="10" height="10" as="geometry" /></mxCell><mxCell id="c151" value="&lt;b&gt;C4&lt;/b&gt;&lt;br&gt;100 nF&lt;br&gt;cerámico" style="text;html=1;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1982" y="490" width="110" height="70" as="geometry" /></mxCell><mxCell id="n1" value="&lt;b&gt;J1 · Alimentación USB 5 V&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;PC (pruebas) · powerbank o baterías (diseño final)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="60" y="52" width="300" height="58" as="geometry" /></mxCell><mxCell id="n2" value="&lt;b&gt;⚠ Pin 5V removido&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;aislado del +5 V de servos&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#C62828;" parent="1" vertex="1"><mxGeometry x="152" y="630" width="240" height="50" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="notas" name="Notas y materiales"><mxGraphModel dx="1380" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="700" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c133" value="&lt;b style='font-size:26px'&gt;Receptor — Notas de montaje y lista de materiales&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="44" as="geometry" /></mxCell><mxCell id="c134" value="&lt;b style='font-size:20px'&gt;Notas de montaje&lt;/b&gt;&lt;ol style='margin:8px 0 0 0;padding-left:24px;line-height:1.5'&gt;&lt;li&gt;&lt;b&gt;Dos alimentaciones separadas.&lt;/b&gt; Los servos toman 5 V de U2 (MP1584, alimentado por PS1) a través de los pines de la placa base. El ESP32 se alimenta por su micro-USB: desde la PC durante las pruebas y desde un powerbank o paquete de baterías en el diseño final.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Pin 5V del ESP32 removido&lt;/b&gt;, para que no quede unido a los 5 V de la placa base. Así el regulador no inyecta corriente al USB y una caída de tensión del riel de servos no reinicia el ESP32.&lt;/li&gt;&lt;li&gt;&lt;b&gt;GND común:&lt;/b&gt; el GND del ESP32 está unido al de los servos y de U2 (referencia de la señal PWM).&lt;/li&gt;&lt;li&gt;C1 (470 µF) y C2 (100 nF) en paralelo sobre los 5 V de servos, junto a los pines de la placa base. C1 entrega los picos de corriente cortos y C2 filtra el ruido de alta frecuencia.&lt;/li&gt;&lt;li&gt;C3 (470 µF) y C4 (100 nF) en paralelo en la entrada del regulador (IN+ / IN−): entregan los pulsos de corriente de la conmutación y reducen a la mitad el pico que ve la fuente de 12 V.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Medición de corriente con osciloscopio:&lt;/b&gt; resistencia de medición en el cable &lt;b&gt;negativo&lt;/b&gt; de PS1 y masa de la punta siempre en GND (ver &lt;code&gt;docs/pruebas/PLAN_LABORATORIO.md&lt;/code&gt;).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Anular en GPIO23.&lt;/b&gt; Antes estaba en GPIO12 (pin de &lt;i&gt;strapping&lt;/i&gt;, MTDI) y el dedo se movía con dificultad; con el mismo servo en GPIO13 o GPIO23 respondió mucho mejor. Evitar GPIO12 para servos.&lt;/li&gt;&lt;li&gt;Sugerencia (validar): fusible en la entrada de 12 V.&lt;/li&gt;&lt;/ol&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=12;fontSize=16;fillColor=#FFFDE7;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1300" height="380" as="geometry" /></mxCell><mxCell id="c135" value="&lt;b style='font-size:20px'&gt;Lista de materiales&lt;/b&gt;&lt;table style='font-size:16px;margin-top:8px' cellpadding='5'&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;PS1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Fuente 12 V DC / 4 A&lt;/td&gt;&lt;td width='40'&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;C1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;470 µF / 35 V electrolítico&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;U2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Regulador buck MP1584 (5 V / 3 A)&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;C2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;100 nF cerámico&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;U1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;ESP32 DevKit (pin 5V removido)&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;J1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Alimentación USB 5 V: PC (pruebas) / powerbank (final)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;M1…M5&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Microservo SG90 (dedos)&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;C3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;470 µF / 35 V electrolítico (entrada de U2)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;M6, M7&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Servo MG946R (muñeca)&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;C4&lt;/b&gt;&lt;/td&gt;&lt;td&gt;100 nF cerámico (entrada de U2)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;b&gt;Consumo medido a 12 V&lt;/b&gt; (&lt;code&gt;docs/pruebas/evidencia/2026-10-15&lt;/code&gt;): 75–100 mA en reposo, ~0,2 A moviendo la muñeca, picos menores a 0,75 A." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=12;fontSize=16;fillColor=#FAFAFA;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="1300" height="300" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>