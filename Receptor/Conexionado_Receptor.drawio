"geometry"><mxPoint x="1570" y="400" as="sourcePoint"/><mxPoint x="1570" y="100" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c117" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=4;strokeColor=#212121;fontSize=14;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1570" y="640" as="sourcePoint"/><mxPoint x="1570" y="930" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c118" value="&lt;b&gt;U2 · Buck&lt;/b&gt;&lt;br&gt;12 V → 5,0 V · 3 A" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;verticalAlign=bottom;spacingBottom=30;fillColor=#EDE7F6;strokeColor=#4527A0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1520" y="400" width="220" height="240" as="geometry"/></mxCell><mxCell id="c119" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1548" y="456" width="120" height="80" as="geometry"/></mxCell><mxCell id="c120" value="OUT+" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;rounded=0;fontSize=14;fontStyle=1;fillColor=#FFCDD2;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1540" y="400" width="60" height="24" as="geometry"/></mxCell><mxCell id="c121" value="OUT−" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;rounded=0;fontSize=14;fontStyle=1;fillColor=#E0E0E0;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1540" y="616" width="60" height="24" as="geometry"/></mxCell><mxCell id="c122" value="IN+" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;rounded=0;fontSize=14;fontStyle=1;fillColor=#E1BEE7;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1680" y="460" width="60" height="24" as="geometry"/></mxCell><mxCell id="c123" value="IN−" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;rounded=0;fontSize=14;fontStyle=1;fillColor=#E0E0E0;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1680" y="560" width="60" height="24" as="geometry"/></mxCell><mxCell id="c124" value="+12 V" style="endArrow=none;html=1;rounded=0;strokeWidth=3;strokeColor=#7B1FA2;fontSize=14;labelBackgroundColor=#FFFFFF;fontColor=#7B1FA2;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1740" y="472" as="sourcePoint"/><mxPoint x="1820" y="472" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c125" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=3;strokeColor=#212121;fontSize=14;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1740" y="572" as="sourcePoint"/><mxPoint x="1820" y="572" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c126" value="&lt;b&gt;PS1 · Fuente&lt;/b&gt;&lt;br&gt;12 V DC · 4 A" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;verticalAlign=bottom;spacingBottom=24;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1820" y="400" width="220" height="240" as="geometry"/></mxCell><mxCell id="c127" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1892" y="444" width="135" height="87" as="geometry"/></mxCell><mxCell id="c128" value="+12V" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;rounded=0;fontSize=14;fontStyle=1;fillColor=#E1BEE7;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1820" y="460" width="60" height="24" as="geometry"/></mxCell><mxCell id="c129" value="−" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;rounded=0;fontSize=14;fontStyle=1;fillColor=#E0E0E0;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1820" y="560" width="60" height="24" as="geometry"/></mxCell><mxCell id="c130" value="&lt;b style='font-size:26px'&gt;Diagrama de conexionado — Receptor (mano / brazo robótico)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="4" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c131" value="Fuente: Receptor.ino (pines) · MEJORAS_HARDWARE_Y_FIRMWARE.md §2.3 · Ilustraciones representativas · Notas y BOM en hoja 2" style="text;html=1;whiteSpace=wrap;fontSize=14;align=right;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1240" y="10" width="800" height="30" as="geometry"/></mxCell><mxCell id="c132" value="&lt;b&gt;Referencias&lt;/b&gt;&lt;br&gt;&lt;span style='color:#F57C00;font-weight:bold'&gt;━━━&lt;/span&gt; Señal PWM 3,3 V&lt;br&gt;&lt;span style='color:#D32F2F;font-weight:bold'&gt;━━━&lt;/span&gt; +5 V&lt;br&gt;&lt;span style='color:#212121;font-weight:bold'&gt;━━━&lt;/span&gt; GND&lt;br&gt;&lt;span style='color:#7B1FA2;font-weight:bold'&gt;━━━&lt;/span&gt; +12 V (entrada)&lt;br&gt;● Unión soldada / bornera&lt;br&gt;⌒ Cruce sin conexión&lt;br&gt;Servo: S naranja · + rojo · − marrón" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#FAFAFA;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="1780" y="690" width="260" height="180" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="notas" name="Notas y materiales"><mxGraphModel dx="1380" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c133" value="&lt;b style='font-size:26px'&gt;Receptor — Notas de montaje y lista de materiales&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="44" as="geometry"/></mxCell><mxCell id="c134" value="&lt;b style='font-size:20px'&gt;Notas de montaje&lt;/b&gt;&lt;ol style='margin:8px 0 0 0;padding-left:24px;line-height:1.5'&gt;&lt;li&gt;El ESP32 se alimenta &lt;b&gt;solo&lt;/b&gt; por el pin 5V a través de D1 + C2. No usar el miniplug de la placa (AMS1117-5.0 disiparía demasiado).&lt;/li&gt;&lt;li&gt;D1 aísla la lógica: si el riel de servos cae por un pico de arranque, C2 sostiene al ESP32 y se evita el Brownout Reset.&lt;/li&gt;&lt;li&gt;Masa en estrella: cada retorno (servos, ESP32, C2, Buck) llega con su propio cable al terminal (−) de C1.&lt;/li&gt;&lt;li&gt;C1 lo más cerca posible de la bornera de servos; C3…C9 soldados directamente en cada conector.&lt;/li&gt;&lt;li&gt;&lt;b&gt;⚠ GPIO12&lt;/b&gt; es pin de &lt;i&gt;strapping&lt;/i&gt; (MTDI): si está en alto durante el reset, el ESP32 no arranca. Verificar que M4 no lo lleve a alto; si ocurre, reasignar a un GPIO libre (p. ej. GPIO4) y actualizar &lt;code&gt;PIN_SERVO_ANULAR&lt;/code&gt;.&lt;/li&gt;&lt;li&gt;Sugerencia (no incluida en el documento de diseño, validar): fusible en la entrada de 12 V.&lt;/li&gt;&lt;/ol&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=12;fontSize=16;fillColor=#FFFDE7;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1300" height="270" as="geometry"/></mxCell><mxCell id="c135" value="&lt;b style='font-size:20px'&gt;Lista de materiales&lt;/b&gt;&lt;table style='font-size:16px;margin-top:8px' cellpadding='5'&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;PS1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Fuente 12 V DC / 4 A&lt;/td&gt;&lt;td width='40'&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;C1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;2200 µF / 16 V electrolítico Low-ESR&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;U2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Regulador Buck 5,0 V / 3 A&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;C2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;470 µF / 16 V electrolítico&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;U1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;ESP32 DevKit&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;C3…C9&lt;/b&gt;&lt;/td&gt;&lt;td&gt;100 nF MLCC (1 por servo)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;M1…M5&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Microservo SG90 (dedos)&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;D1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;1N5822 Schottky 3 A&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;M6, M7&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Servo MG946R (muñeca)&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;D2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;TVS SMBJ6.0A&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;b&gt;Consumo estimado:&lt;/b&gt; ≈1,9 A medio · picos de arranque 4–5,5 A durante 20–50 ms (cubiertos por C1 + slew-rate del firmware)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=12;fontSize=16;fillColor=#FAFAFA;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="1300" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>